{
  "name": "@purr/core",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first desktop client for HTTP and GraphQL APIs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purr-app/Purr.git"
  },
  "bugs": {
    "url": "https://github.com/purr-app/Purr/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "type": "module",
  "files": [
    "dist-core"
  ],
  "exports": {
    "./app": {
      "types": "./dist-core/types/app/public.d.ts",
      "import": "./dist-core/app.js"
    },
    "./extension-api": {
      "types": "./dist-core/types/extension-api/index.d.ts",
      "import": "./dist-core/extension-api.js"
    },
    "./ui": {
      "types": "./dist-core/types/extension-api/ui.d.ts",
      "import": "./dist-core/ui.js"
    },
    "./test-kit": {
      "types": "./dist-core/types/extension-api/test-kit.d.ts",
      "import": "./dist-core/test-kit.js"
    },
    "./styles": "./dist-core/styles.css"
  },
  "scripts": {
    "prepare": "npm run build:core",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release:version": "changeset version && node scripts/sync-release-version.mjs --write",
    "release:check": "node scripts/sync-release-version.mjs --check",
    "dev": "vite",
    "test": "npm run build:core && tsx --test tests/*.test.ts",
    "test:ui": "npm run build:core && playwright test",
    "check:repo": "node scripts/check-repository-policy.mjs && npm run release:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts eslint.config.js playwright.config.ts tailwind.config.ts vite.config.ts vite.core.config.ts",
    "build": "npm run build:app && npm run build:core",
    "build:app": "tsc && vite build",
    "build:core": "vite build --config vite.core.config.ts && tsc -p tsconfig.core-build.json",
    "build:consumer": "npm run build:core && tsc -p tests/fixtures/core-consumer/tsconfig.json && vite build --config tests/fixtures/core-consumer/vite.config.ts",
    "check:core-package": "npm run build:consumer && node scripts/check-core-package.mjs && cargo check --manifest-path tests/fixtures/core-consumer/src-tauri/Cargo.toml",
    "check:core-determinism": "node scripts/check-core-determinism.mjs",
    "benchmark:responses": "tsx scripts/performance/response-baseline.ts",
    "fixture:responses": "tsx scripts/performance/response-fixture-server.ts",
    "fixture:traces": "tsx scripts/performance/trace-fixture-server.ts",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cm6-graphql": "^0.2.2",
    "fast-xml-parser": "^5.11.1",
    "graphql": "^16.14.2",
    "graphql-language-service": "^5.7.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.40.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tough-cookie": "^6.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.11.0",
    "postcss": "^8.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.4"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
